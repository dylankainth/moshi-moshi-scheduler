# Copy to .env and fill in. Read by `python -m foresight ...` from the current directory.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# FORESIGHT_INFERENCE=openai   # none | vultr | openai (default: openai if OPENAI_API_KEY is set)
# FORESIGHT_TOKEN=             # owner token for cloud mode
# VULTR_INFERENCE_KEY=

# Attribution thresholds (seconds) for testing; leave unset for the defaults in foresight/attribution.py:Cfg
# FORESIGHT_IDLE_OFF=300       # this long without input never counts
# FORESIGHT_DETOUR_MAX=300     # off-task runs up to this long between on-task work count
# FORESIGHT_UNRELATED_ASK=900  # this much trailing off-task time asks "done with X?"
# FORESIGHT_JUDGE_MIN=60       # only ask the LLM about ambiguous stretches at least this long
# FORESIGHT_MAX_GAP=10         # a longer wait between samples is a gap (sleep / agent off)
# FORESIGHT_SIM_ON=0.30        # embedding similarity (0-1) that counts as on-task
